{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "chatbot/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/chatbot/(.*)", "dest": "/chatbot/static/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
